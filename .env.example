# Webhook do n8n que recebe os leads (POST JSON). Só no servidor (sem NEXT_PUBLIC_), usado pelo Route Handler /api/lead.
WEBHOOK_URL=https://webhook3.assessorialpha.com/webhook/<id-do-webhook-n8n>

# Opcional: URL pública usada nas metatags OG. Na Vercel, se ausente, usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://aos.assessorialpha.com
